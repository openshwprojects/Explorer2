<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Embedded by src\Explorer2.rc (resource type 24 = RT_MANIFEST, id 1).

  DPI awareness: without it Windows draws Explorer2 at 96 DPI and stretches the picture on every display set to
  more than 100% scaling, which makes all text blurry. Explorer2 lays everything out in DIPs (1/96 inch) and lets
  Direct2D draw them at the window's real DPI.
    dpiAwareness PerMonitorV2  Windows 10 1703+: per-monitor, with WM_DPICHANGED when the window changes monitor
                 PerMonitor    Windows 10 1607 fallback
    dpiAware     true/pm       Windows 8.1: per-monitor; Windows 7 / 8: one system DPI
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
