$HEADER
GENCAD 1.4
USER "KiCad Pcbnew 8.0"
DRAWING "CAN_FD_TRANSCEIVER_REV_B"
UNITS MM
ORIGIN 0 0
$ENDHEADER
$BOARD
LINE 0 0 50 0
LINE 50 0 50 30
LINE 50 30 0 30
LINE 0 30 0 0
$ENDBOARD
$PADS
PAD P_SOIC 1 0
RECTANGLE -0.8 -0.3 1.6 0.6
PAD P_SMD0603 RECTANGLE 0
RECTANGLE -0.45 -0.45 0.9 0.9
PAD V_STD ROUND 0.3
CIRCLE 0 0 0.35
$ENDPADS
$SHAPES
SHAPE SOIC8
RECTANGLE -2.0 -2.5 4.0 5.0
PIN 1 P_SOIC -2.7  1.905 TOP 0 0
PIN 2 P_SOIC -2.7  0.635 TOP 0 0
PIN 3 P_SOIC -2.7 -0.635 TOP 0 0
PIN 4 P_SOIC -2.7 -1.905 TOP 0 0
PIN 5 P_SOIC  2.7 -1.905 TOP 0 0
PIN 6 P_SOIC  2.7 -0.635 TOP 0 0
PIN 7 P_SOIC  2.7  0.635 TOP 0 0
PIN 8 P_SOIC  2.7  1.905 TOP 0 0
SHAPE R0603
PIN 1 P_SMD0603 -0.8 0 TOP 0 0
PIN 2 P_SMD0603  0.8 0 TOP 0 0
$ENDSHAPES
$DEVICES
DEVICE "DEV_TCAN1042"
PART "TCAN1042HGV"
TYPE IC
DEVICE "DEV_R120"
VALUE "120R"
TYPE RES
$ENDDEVICES
$COMPONENTS
COMPONENT U1
DEVICE "DEV_TCAN1042"
PLACE 20.0 15.0
LAYER TOP
ROTATION 0
SHAPE SOIC8 0 0
COMPONENT R1
DEVICE "DEV_R120"
PLACE 35.0 15.0
LAYER BOTTOM
ROTATION 90
SHAPE R0603 MIRRORX 0
$ENDCOMPONENTS
$SIGNALS
SIGNAL CAN_H
NODE U1 7
NODE R1 1
SIGNAL CAN_L
NODE U1 6
NODE R1 2
SIGNAL VCC_5V
NODE U1 3
$ENDSIGNALS
$TRACKS
TRACK T_DIFF 0.25
TRACK T_PWR  0.50
$ENDTRACKS
$ROUTES
ROUTE CAN_H
TRACK T_DIFF
LAYER TOP
WIRE 22.7 15.635 30.0 15.8
VIA V_STD 30.0 15.8 ALL 0.3
LAYER BOTTOM
WIRE 30.0 15.8 35.0 15.8
ROUTE CAN_L
TRACK T_DIFF
LAYER TOP
WIRE 22.7 14.365 30.0 14.2
VIA V_STD 30.0 14.2 ALL 0.3
LAYER BOTTOM
WIRE 30.0 14.2 35.0 14.2
$ENDROUTES
