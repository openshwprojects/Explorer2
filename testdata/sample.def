VERSION 5.8 ;
DESIGN riscv_alu_tile ;
UNITS DISTANCE MICRONS 100 ;
DIEAREA ( 0 0 ) ( 4000 3000 ) ;
COMPONENTS 4 ;
- U_NAND1 NAND2_X1 + PLACED ( 800 800 ) N ;
- U_NAND2 NAND2_X1 + PLACED ( 2000 800 ) N ;
- U_DFF1 DFF_X2 + PLACED ( 1400 1800 ) N ;
- U_BUF1 CLKBUF_X4 + PLACED ( 2800 1800 ) N ;
END COMPONENTS
NETS 2 ;
- clk_net
  + ROUTED METAL1 ( 800 800 ) ( 2000 800 )
  + ROUTED METAL2 ( 2000 800 ) ( 2800 1800 ) ;
- data_net
  + ROUTED METAL1 ( 800 800 ) ( 1400 1800 ) ;
END NETS
END DESIGN
