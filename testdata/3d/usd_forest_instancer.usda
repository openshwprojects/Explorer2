#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    double3 xformOp:translate = (0.0, 5.0, 0.0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Scope "Prototypes"
    {
        def Mesh "Obelisk"
        {
            point3f[] points = [(-2, 0, -2), (2, 0, -2), (2, 0, 2), (-2, 0, 2), (0, 8, 0)]
            int[] faceVertexCounts = [4, 3, 3, 3, 3]
            int[] faceVertexIndices = [0, 3, 2, 1,  0, 1, 4,  1, 2, 4,  2, 3, 4,  3, 0, 4]
        }
    }

    def PointInstancer "Ring"
    {
        rel prototypes = [</World/Prototypes/Obelisk>]
        int[] protoIndices = [0, 0, 0]
        point3f[] positions = [(-25, 0, 0), (0, 10, 0), (30, 0, 0)]
        float3[] scales = [(1, 1, 1), (1, 2, 1), (1, 1, 1)]
    }
}